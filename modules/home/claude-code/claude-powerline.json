{
  "display": {
    "lines": [
      {
        "segments": {
          "model": { "enabled": true },
          "thinking": { "enabled": true, "showEnabled": false },
          "block": { "enabled": true, "displayStyle": "blocks" },
          "weekly": { "enabled": true, "displayStyle": "blocks" },
          "context": {
            "enabled": true,
            "showPercentageOnly": true,
            "percentageMode": "used"
          }
        }
      }
    ]
  },
  "modelContextLimits": {
    "default": 1000000,
    "sonnet": 1000000,
    "opus": 1000000
  },
  "theme": "custom",
  "colors": {
    "custom": {
      "model": { "bg": "#073642", "fg": "#6c71c4" },
      "thinking": { "bg": "#073642", "fg": "#268bd2" },
      "block": { "bg": "#073642", "fg": "#859900" },
      "weekly": { "bg": "#073642", "fg": "#859900" },
      "context": { "bg": "#073642", "fg": "#586e75" },
      "contextWarning": { "bg": "#073642", "fg": "#b58900" },
      "contextCritical": { "bg": "#073642", "fg": "#cb4b16" }
    }
  }
}
